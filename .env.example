APP_NAME="Finance ERP"
APP_ENV=development
APP_PORT=8000

FRONTEND_URL=http://localhost:5173

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=finance_erp
DB_USER=root
DB_PASSWORD=

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

BCRYPT_ROUNDS=12

# Comma-separated existing user IDs authorized as platform operators
PLATFORM_OPERATOR_USER_IDS=
# Generate a separate random 32-byte key, encoded as 64 hexadecimal characters
MFA_ENCRYPTION_KEY=
# Only list actual reverse proxy IPs; leave empty for local direct connections
TRUSTED_PROXY_IPS=
# Optional database names on the same MySQL server for metadata monitoring
PLATFORM_MONITORED_DATABASES=
